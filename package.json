{
  "name": "gastos",
  "private": true,
  "license": "MIT",
  "scripts": {
    "dev": "pnpm --filter web dev",
    "build": "pnpm --filter web build",
    "typecheck": "pnpm --filter web typecheck",
    "lint": "pnpm --filter web lint",
    "test": "pnpm --filter web test && pnpm --filter rules-tests test && pnpm --filter gmail-bank-ingest test",
    "test:web": "pnpm --filter web test",
    "test:rules": "pnpm --filter rules-tests test",
    "test:ingest": "pnpm --filter gmail-bank-ingest test",
    "verify:pwa": "pnpm --filter web verify:pwa",
    "emulators": "firebase emulators:start --config firebase/firebase.json --project qcris-gastos-diarios",
    "seed:emulator": "node scripts/seed-emulator.mjs",
    "backup": "node kyber/scripts/backup.mjs",
    "restore": "node kyber/scripts/restore.mjs",
    "periods:check": "node scripts/check-periods.mjs"
  },
  "devDependencies": {
    "firebase-admin": "^14.4.0"
  },
  "packageManager": "pnpm@11.4.0"
}
