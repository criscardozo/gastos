{
  "name": "gastos",
  "private": true,
  "license": "MIT",
  "scripts": {
    "dev": "pnpm --filter web dev",
    "build": "pnpm --filter web build",
    "typecheck": "pnpm --filter web typecheck",
    "lint": "pnpm --filter web lint",
    "test": "pnpm --filter web test && pnpm --filter rules-tests test && pnpm --filter gmail-bank-ingest test",
    "test:web": "pnpm --filter web test",
    "test:rules": "pnpm --filter rules-tests test",
    "test:ingest": "pnpm --filter gmail-bank-ingest test",
    "verify:pwa": "node scripts/verify-pwa.mjs",
    "emulators": "firebase emulators:start --config firebase/firebase.json --project qcris-gastos-diarios",
    "seed:emulator": "node scripts/seed-emulator.mjs",
    "backup": "node scripts/backup.mjs",
    "restore": "node scripts/restore.mjs",
    "periods:check": "node scripts/check-periods.mjs",
    "version:set": "node scripts/set-version.mjs",
    "install:ios": "node scripts/install-ios.mjs",
    "rules:drift": "node scripts/check-rules-drift.mjs",
    "test:scripts": "node --test 'scripts/test/*.test.mjs' && python3 -m unittest discover -q -s design-system -p 'test_*.py'"
  },
  "devDependencies": {
    "firebase-admin": "^14.5.0"
  },
  "packageManager": "pnpm@11.4.0"
}
