#!/bin/sh
# The two checks that broke CI, run before the push instead of after it.
#
# CI went red three pushes in a row on `emit.py --verify` — a 17px outside the
# scale — and each round trip cost a push, a wait, and a red badge. Both checks
# here take seconds and need no network, which is the whole reason they are
# worth running locally: anything slower gets skipped with --no-verify until
# the hook is decoration.
#
# Deliberately NOT here: the test suites, the build, the emulator. Those are
# CI's job. A pre-push hook that takes a minute is one somebody learns to
# bypass, and a hook that is always bypassed is worse than none — it looks
# like a guard on the way in.
#
# Install once:  git config core.hooksPath .githooks
# Skip once:     git push --no-verify

set -e

echo "pre-push: design tokens…"
python3 design-system/emit.py --verify

echo "pre-push: typecheck…"
pnpm --filter web typecheck

echo "pre-push: ok"
