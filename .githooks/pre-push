#!/bin/sh
# The two checks that broke CI, run before the push instead of after it.
#
# CI went red three pushes in a row on `emit.py --verify` — a 17px outside the
# scale — and each round trip cost a push, a wait, and a red badge. Both checks
# here take seconds and need no network, which is the whole reason they are
# worth running locally: anything slower gets skipped with --no-verify until
# the hook is decoration.
#
# The web suite joined them on 15/9/2026, and the reason it had been left out no
# longer held. That reason was time — "a hook that takes a minute is one
# somebody learns to bypass" — and it was written about a hypothetical.
# Measured: the 472 tests take ONE second, typecheck one, the token check under
# one. The whole hook is about three.
#
# What put it here is a push that should not have happened. The suite was run,
# it was red, and the commit and the push went out anyway, because they were
# chained with `;` instead of `&&` — so the failure never reached the step it
# should have stopped. Running a check before an action is not the same as the
# action depending on the check. A hook is where it depends.
#
# Still NOT here: the build, the emulator, the e2e. Those cost minutes and are
# CI's job. A hook that is always bypassed is worse than none — it looks like a
# guard on the way in.
#
# Install once:  git config core.hooksPath .githooks
# Skip once:     git push --no-verify

set -e

echo "pre-push: design tokens…"
python3 design-system/emit.py --verify

echo "pre-push: typecheck…"
pnpm --filter web typecheck

echo "pre-push: tests…"
pnpm --filter web test

echo "pre-push: ok"
