{
  "$description": "Gastos design tokens. Source of truth; the web CSS and the iOS theme are generated from this file.",
  "color": {
    "core": {
      "bg": {
        "$type": "color",
        "$description": "App background",
        "$value": {
          "light": "#faf6ef",
          "dark": "#191410"
        },
        "$extensions": {
          "gastos.swift": "bg"
        }
      },
      "surface": {
        "$type": "color",
        "$description": "Cards and sheets",
        "$value": {
          "light": "#ffffff",
          "dark": "#242019"
        },
        "$extensions": {
          "gastos.swift": "surface"
        }
      },
      "ink": {
        "$type": "color",
        "$description": "Primary text",
        "$value": {
          "light": "#241a10",
          "dark": "#f6eee2"
        },
        "$extensions": {
          "gastos.swift": "ink"
        }
      },
      "ink-secondary": {
        "$type": "color",
        "$description": "Secondary text",
        "$value": {
          "light": "#8f8272",
          "dark": "#a2937f"
        },
        "$extensions": {
          "gastos.swift": "inkSecondary"
        }
      },
      "ink-tertiary": {
        "$type": "color",
        "$description": "Tertiary text, section labels",
        "$value": {
          "light": "#b4a794",
          "dark": "#6e6153"
        },
        "$extensions": {
          "gastos.swift": "inkTertiary"
        }
      },
      "accent": {
        "$type": "color",
        "$description": "Brand coral",
        "$value": {
          "light": "#ff5c39",
          "dark": "#ff5c39"
        }
      },
      "accent-strong": {
        "$type": "color",
        "$description": "Coral for text on light surfaces",
        "$value": {
          "light": "#e8492a",
          "dark": "#e8492a"
        }
      }
    },
    "line": {
      "line-card": {
        "$type": "color",
        "$description": "Card border",
        "$value": {
          "light": {
            "base": "#241a10",
            "alpha": 0.08
          },
          "dark": {
            "base": "#f6eee2",
            "alpha": 0.08
          }
        },
        "$extensions": {
          "gastos.swift": "border"
        }
      },
      "line-pill": {
        "$type": "color",
        "$description": "Pill and chip border",
        "$value": {
          "light": {
            "base": "#241a10",
            "alpha": 0.1
          },
          "dark": {
            "base": "#f6eee2",
            "alpha": 0.1
          }
        },
        "$extensions": {
          "gastos.swift": "borderPill"
        }
      },
      "line-soft": {
        "$type": "color",
        "$description": "Hairline between rows",
        "$value": {
          "light": {
            "base": "#241a10",
            "alpha": 0.06
          },
          "dark": {
            "base": "#f6eee2",
            "alpha": 0.06
          }
        },
        "$extensions": {
          "gastos.swift": "separator"
        }
      },
      "fill": {
        "$type": "color",
        "$description": "Inset fills",
        "$value": {
          "light": {
            "base": "#241a10",
            "alpha": 0.06
          },
          "dark": {
            "base": "#f6eee2",
            "alpha": 0.07
          }
        },
        "$extensions": {
          "gastos.swift": "fill"
        }
      },
      "track": {
        "$type": "color",
        "$description": "Progress track",
        "$value": {
          "light": {
            "base": "#241a10",
            "alpha": 0.08
          },
          "dark": {
            "base": "#f6eee2",
            "alpha": 0.08
          }
        },
        "$extensions": {
          "gastos.swift": "track"
        }
      }
    },
    "state": {
      "good": {
        "$type": "color",
        "$description": "On track",
        "$value": {
          "light": "#2e9e5b",
          "dark": "#40be74"
        },
        "$extensions": {
          "gastos.swift": "green"
        }
      },
      "good-text": {
        "$type": "color",
        "$description": "On-track text",
        "$value": {
          "light": "#1f7a45",
          "dark": "#6fd79a"
        },
        "$extensions": {
          "gastos.swift": "greenText"
        }
      },
      "warn": {
        "$type": "color",
        "$description": "Running low",
        "$value": {
          "light": "#e39a0c",
          "dark": "#e39a0c"
        }
      },
      "warn-text": {
        "$type": "color",
        "$description": "Running-low text",
        "$value": {
          "light": "#b87804",
          "dark": "#e39a0c"
        },
        "$extensions": {
          "gastos.swift": "amberText"
        }
      },
      "over": {
        "$type": "color",
        "$description": "Over budget",
        "$value": {
          "light": "#e5484d",
          "dark": "#e5484d"
        }
      },
      "over-text": {
        "$type": "color",
        "$description": "Over-budget text",
        "$value": {
          "light": "#e5484d",
          "dark": "#e5484d"
        }
      }
    },
    "member": {
      "member-blue": {
        "$type": "color",
        "$description": "Member C",
        "$value": {
          "light": "#2a6fdb",
          "dark": "#4b87e8"
        },
        "$extensions": {
          "gastos.swift": "avatarBlue"
        }
      },
      "member-pink": {
        "$type": "color",
        "$description": "Member N",
        "$value": {
          "light": "#e0447c",
          "dark": "#ef6d9c"
        },
        "$extensions": {
          "gastos.swift": "avatarPink"
        }
      }
    }
  },
  "type": {
    "$description": "Steps the components actually use, counted with their weight and per platform. The row step is 14 on web and 14.5 on iOS, and the screen title 22 and 18 \u2014 deliberate, so the system names both rather than picking one and being wrong on the other client.",
    "s13": {
      "$type": "dimension",
      "$value": "13px",
      "$extensions": {
        "gastos.weight": {
          "web": 600,
          "ios": 600
        },
        "gastos.uses": {
          "web": 77,
          "ios": 22
        }
      }
    },
