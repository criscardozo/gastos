# macOS
.DS_Store

# Local agent workspace
.claude/
# Skills vendored by `npx skills add`. The lockfile IS committed (it records
# what is installed and from which commit); the 90-odd files it expands to are
# not ours to carry.
.agents/

# Node
node_modules/
.pnpm-store/
*.log

# Next.js
apps/web/.next/
apps/web/out/
apps/web/.vercel/
apps/web/next-env.d.ts

# Env files (Firebase client config is public by design, but keep env files local)
.env
.env.local
.env.*.local

# Firebase
.firebase/
firebase-debug.log
firestore-debug.log
ui-debug.log
firebase/rules-tests/coverage/
# Service account key (backup script) + local backups — never commit
firebase/service-account.json
backups/

# Xcode
apps/ios/*.xcodeproj/xcuserdata/
apps/ios/*.xcodeproj/project.xcworkspace/xcuserdata/
xcuserdata/
DerivedData/
*.xcresult
# Build output of install-device.sh (device sideload) and ad-hoc xcodebuild runs
apps/ios/build-device/
apps/ios/build/

# Test output
coverage/
.vitest/
apps/web/tsconfig.tsbuildinfo
.gstack/

# Next 16 writes these on every `next dev` (see
# node_modules/next/dist/server/lib/generate-agent-files.js) and re-creates them
# if deleted. Ignored rather than committed: the repo's agent instructions are
# the CLAUDE.md Cristian wrote at the root, and a generated one appearing in
# apps/web would quietly add a second voice nobody chose.
apps/web/AGENTS.md
apps/web/CLAUDE.md
