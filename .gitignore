# macOS
.DS_Store

# Local agent workspace
.claude/
# Skills vendored by `npx skills add`. The lockfile IS committed (it records
# what is installed and from which commit); the 90-odd files it expands to are
# not ours to carry.
.agents/

# Node
node_modules/
.pnpm-store/
*.log

# Next.js
apps/web/.next/
apps/web/out/
apps/web/next-env.d.ts

# Env files (Firebase client config is public by design, but keep env files local)
.env
.env.local
.env.*.local

# Firebase
.firebase/
firebase-debug.log
firestore-debug.log
ui-debug.log
firebase/rules-tests/coverage/
# Service account key (backup script) + local backups — never commit
firebase/service-account.json
backups/

# Xcode
apps/ios/*.xcodeproj/xcuserdata/
apps/ios/*.xcodeproj/project.xcworkspace/xcuserdata/
xcuserdata/
DerivedData/
*.xcresult
# Build output of install-device.sh (device sideload) and ad-hoc xcodebuild runs
apps/ios/build-device/
apps/ios/build/

# Test output
coverage/
.vitest/
apps/web/tsconfig.tsbuildinfo
.gstack/

# Next 16 writes these on every `next dev` (see
# node_modules/next/dist/server/lib/generate-agent-files.js) and re-creates them
# if deleted. Ignored rather than committed: the repo's agent instructions are
# the CLAUDE.md Cristian wrote at the root, and a generated one appearing in
# apps/web would quietly add a second voice nobody chose.
apps/web/AGENTS.md
apps/web/CLAUDE.md
# Vercel's own link + the OIDC token it pulls. The link belongs at the ROOT:
# the project's Root Directory is apps/web, so a CLI deploy has to upload the
# whole workspace or pnpm's `catalog:` versions cannot resolve.
.vercel/
.env.local

# The Xcode project is GENERATED from apps/ios/project.yml by xcodegen and not
# tracked — Cristian's decision, 2026-09-25, the same as Stock's. Every run
# rewrote ~35 object UUIDs and xcodebuild downgraded a scheme, so the tracked
# copy was a diff that never meant anything, and twice it went stale in a way
# that did mean something (a renamed file, a new test file the project did not
# name). Only Package.resolved stays: it is SPM's lockfile, the one file here
# that pins what gets built. Git cannot re-include a file under an excluded
# parent, hence one pair of lines per level.
apps/ios/Gastos.xcodeproj/*
!apps/ios/Gastos.xcodeproj/project.xcworkspace/
apps/ios/Gastos.xcodeproj/project.xcworkspace/*
!apps/ios/Gastos.xcodeproj/project.xcworkspace/xcshareddata/
apps/ios/Gastos.xcodeproj/project.xcworkspace/xcshareddata/*
!apps/ios/Gastos.xcodeproj/project.xcworkspace/xcshareddata/swiftpm/
apps/ios/Gastos.xcodeproj/project.xcworkspace/xcshareddata/swiftpm/*
!apps/ios/Gastos.xcodeproj/project.xcworkspace/xcshareddata/swiftpm/Package.resolved
