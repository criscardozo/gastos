{
  "_comment": [
    "Cross-platform test vectors for matching the bank's USD charges to the",
    "expenses they paid for. The matcher exists twice — apps/web/src/lib/",
    "bank-match.ts and apps/ios/GastosDiarios/Core/BankMatch.swift — and both",
    "must produce the SAME assignment for every case here. Same arrangement as",
    "period-test-vectors.json, and for the same reason: duplicated logic only",
    "stays honest if one file decides what it does.",
    "",
    "Each case lists charges and candidate expenses, the reference rate learned",
    "from history (null = nothing verified yet), and the expected chargeId →",
    "expenseId assignment (null = no suggestion, pick by hand)."
  ],
  "learnRate": [
    {
      "name": "nothing verified yet",
      "expenses": [
        { "amountCents": 6390, "usdCents": null, "verified": false },
        { "amountCents": 1250, "usdCents": null, "verified": false }
      ],
      "expected": null
    },
    {
      "name": "one verified pair",
      "expenses": [
        { "amountCents": 10000, "usdCents": 7123, "verified": true }
      ],
      "expected": 0.7123
    },
    {
      "name": "median, so a mistyped pair cannot drag it",
      "expenses": [
        { "amountCents": 10000, "usdCents": 7120, "verified": true },
        { "amountCents": 20000, "usdCents": 14240, "verified": true },
        { "amountCents": 10000, "usdCents": 712, "verified": true }
      ],
      "expected": 0.712
    },
    {
      "name": "even count averages the middle two",
      "expenses": [
        { "amountCents": 10000, "usdCents": 7000, "verified": true },
        { "amountCents": 10000, "usdCents": 7200, "verified": true }
      ],
      "expected": 0.71
    },
    {
      "name": "a flag with no figure behind it is not a pair",
      "expenses": [
        { "amountCents": 10000, "usdCents": null, "verified": true }
      ],
      "expected": null
    }
  ],
  "suggestMatches": [
    {
      "name": "the rate alone identifies the expense, with no merchant help",
      "referenceRate": 0.7123,
      "charges": [
        { "id": "c1", "usdCents": 4552, "date": "2026-08-03", "merchant": "" }
      ],
      "expenses": [
        { "id": "right", "amountCents": 6390, "date": "2026-08-03", "note": "", "verified": false },
        { "id": "wrong", "amountCents": 1250, "date": "2026-08-03", "note": "", "verified": false }
      ],
      "expected": { "c1": "right" }
    },
    {
      "name": "the merchant breaks a tie between two similar amounts",
      "referenceRate": 0.7123,
      "charges": [
        { "id": "c1", "usdCents": 4552, "date": "2026-08-03", "merchant": "COLES 0831" }
      ],
      "expenses": [
        { "id": "coles", "amountCents": 6390, "date": "2026-08-03", "note": "Coles", "verified": false },
        { "id": "tren", "amountCents": 6400, "date": "2026-08-03", "note": "Tren a Bondi", "verified": false }
      ],
      "expected": { "c1": "coles" }
    },
    {
      "name": "a charge looks a few days back",
      "referenceRate": 0.7123,
      "charges": [
        { "id": "c1", "usdCents": 4552, "date": "2026-08-06", "merchant": "" }
      ],
      "expenses": [
        { "id": "e1", "amountCents": 6390, "date": "2026-08-03", "note": "", "verified": false }
      ],
      "expected": { "c1": "e1" }
    },
    {
      "name": "but not further than three days",
      "referenceRate": 0.7123,
      "charges": [
        { "id": "c1", "usdCents": 4552, "date": "2026-08-07", "merchant": "" }
      ],
      "expenses": [
        { "id": "e1", "amountCents": 6390, "date": "2026-08-03", "note": "", "verified": false }
      ],
      "expected": { "c1": null }
    },
    {
      "name": "an already-verified expense is never touched again",
      "referenceRate": 0.7123,
      "charges": [
        { "id": "c1", "usdCents": 4552, "date": "2026-08-03", "merchant": "COLES 0831" }
      ],
      "expenses": [
        { "id": "done", "amountCents": 6390, "date": "2026-08-03", "note": "Coles", "verified": true }
      ],
      "expected": { "c1": null }
    },
    {
      "name": "a rate nowhere near the learned one is refused",
      "referenceRate": 0.7123,
      "charges": [
        { "id": "c1", "usdCents": 4552, "date": "2026-08-03", "merchant": "" }
      ],
      "expenses": [
        { "id": "e1", "amountCents": 1200, "date": "2026-08-03", "note": "", "verified": false }
      ],
      "expected": { "c1": null }
    },
    {
      "name": "with nothing learned yet, a plausible ratio is accepted",
      "referenceRate": null,
      "charges": [
        { "id": "c1", "usdCents": 4552, "date": "2026-08-03", "merchant": "" }
      ],
      "expenses": [
        { "id": "e1", "amountCents": 6390, "date": "2026-08-03", "note": "", "verified": false }
      ],
      "expected": { "c1": "e1" }
    },
    {
      "name": "with nothing learned yet, an implausible ratio still is not",
      "referenceRate": null,
      "charges": [
        { "id": "c1", "usdCents": 4552, "date": "2026-08-03", "merchant": "" }
      ],
      "expenses": [
        { "id": "e1", "amountCents": 50000, "date": "2026-08-03", "note": "", "verified": false }
      ],
      "expected": { "c1": null }
    },
    {
      "name": "one expense cannot answer for two charges",
      "referenceRate": 0.7123,
      "charges": [
        { "id": "c1", "usdCents": 4552, "date": "2026-08-03", "merchant": "COLES 0831" },
        { "id": "c2", "usdCents": 4552, "date": "2026-08-03", "merchant": "COLES 0831" }
      ],
      "expenses": [
        { "id": "only", "amountCents": 6390, "date": "2026-08-03", "note": "Coles", "verified": false }
      ],
      "expected": { "c1": "only", "c2": null }
    },
    {
      "name": "two charges land on the two expenses they belong to",
      "referenceRate": 0.7123,
      "charges": [
        { "id": "big", "usdCents": 4552, "date": "2026-08-03", "merchant": "COLES 0831" },
        { "id": "small", "usdCents": 890, "date": "2026-08-03", "merchant": "OPAL TOP UP" }
      ],
      "expenses": [
        { "id": "coles", "amountCents": 6390, "date": "2026-08-03", "note": "Coles", "verified": false },
        { "id": "opal", "amountCents": 1250, "date": "2026-08-03", "note": "Opal", "verified": false }
      ],
      "expected": { "big": "coles", "small": "opal" }
    },
    {
      "name": "the merchant match survives accents and case",
      "referenceRate": 0.7123,
      "charges": [
        { "id": "c1", "usdCents": 1495, "date": "2026-08-03", "merchant": "FARMACIA 12" }
      ],
      "expenses": [
        { "id": "farmacia", "amountCents": 2100, "date": "2026-08-03", "note": "Farmacía", "verified": false },
        { "id": "otro", "amountCents": 2090, "date": "2026-08-03", "note": "Kiosco", "verified": false }
      ],
      "expected": { "c1": "farmacia" }
    }
  ]
}
