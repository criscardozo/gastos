{
  "version": 1,
  "comment": "Cross-platform test vectors for period logic. Both implementations (TS: apps/web/src/lib/periods.ts via vitest; Swift: PeriodLogic via XCTest) MUST pass every case. Dates are calendar-date strings (YYYY-MM-DD); instants are ISO-8601 UTC. Sydney DST 2026: ends Sun 2026-04-05 03:00 AEDT -> 02:00 AEST; starts Sun 2026-10-04 02:00 AEST -> 03:00 AEDT.",
  "addDays": [
    {
      "date": "2026-07-01",
      "days": 13,
      "expected": "2026-07-14"
    },
    {
      "date": "2026-07-14",
      "days": 1,
      "expected": "2026-07-15"
    },
    {
      "date": "2026-02-23",
      "days": 6,
      "expected": "2026-03-01"
    },
    {
      "date": "2024-02-26",
      "days": 6,
      "expected": "2024-03-03"
    },
    {
      "date": "2026-12-28",
      "days": 6,
      "expected": "2027-01-03"
    },
    {
      "date": "2026-01-01",
      "days": -1,
      "expected": "2025-12-31"
    },
    {
      "date": "2026-04-01",
      "days": 7,
      "expected": "2026-04-08"
    },
    {
      "date": "2026-10-01",
      "days": 14,
      "expected": "2026-10-15"
    }
  ],
  "daysBetween": [
    {
      "from": "2026-07-01",
      "to": "2026-07-14",
      "expected": 13
    },
    {
      "from": "2026-07-14",
      "to": "2026-07-01",
      "expected": -13
    },
    {
      "from": "2026-07-11",
      "to": "2026-07-11",
      "expected": 0
    },
    {
      "from": "2026-03-29",
      "to": "2026-04-12",
      "expected": 14
    },
    {
      "from": "2026-09-27",
      "to": "2026-10-11",
      "expected": 14
    },
    {
      "from": "2025-12-29",
      "to": "2026-01-05",
      "expected": 7
    }
  ],
  "periodEndDate": [
    {
      "startDate": "2026-07-01",
      "period": "fortnightly",
      "expected": "2026-07-14"
    },
    {
      "startDate": "2026-07-15",
      "period": "fortnightly",
      "expected": "2026-07-28"
    },
    {
      "startDate": "2026-06-29",
      "period": "weekly",
      "expected": "2026-07-05"
    },
    {
      "startDate": "2026-02-23",
      "period": "weekly",
      "expected": "2026-03-01"
    },
    {
      "startDate": "2024-02-26",
      "period": "weekly",
      "expected": "2024-03-03"
    },
    {
      "startDate": "2026-12-28",
      "period": "weekly",
      "expected": "2027-01-03"
    },
    {
      "startDate": "2026-04-01",
      "period": "weekly",
      "expected": "2026-04-07"
    },
    {
      "startDate": "2026-10-01",
      "period": "fortnightly",
      "expected": "2026-10-14"
    }
  ],
  "containment": [
    {
      "startDate": "2026-07-01",
      "endDate": "2026-07-14",
      "date": "2026-07-01",
      "expected": true
    },
    {
      "startDate": "2026-07-01",
      "endDate": "2026-07-14",
      "date": "2026-07-14",
      "expected": true
    },
    {
      "startDate": "2026-07-01",
      "endDate": "2026-07-14",
      "date": "2026-07-15",
      "expected": false
    },
    {
      "startDate": "2026-07-01",
      "endDate": "2026-07-14",
      "date": "2026-06-30",
      "expected": false
    },
    {
      "startDate": "2026-12-28",
      "endDate": "2027-01-03",
      "date": "2027-01-01",
      "expected": true
    }
  ],
  "cascadeMaterialization": {
    "comment": "Given the last materialized period (or null -> seed from anchorDate), the CURRENT default period type, and today's date (already in the household timezone), return the ordered list of periods to create so that today is covered. Empty when today is already covered or precedes the anchor.",
    "cases": [
      {
        "name": "today inside last period -> nothing",
        "last": {
          "startDate": "2026-07-01",
          "endDate": "2026-07-14"
        },
        "defaultPeriod": "fortnightly",
        "today": "2026-07-11",
        "expected": []
      },
      {
        "name": "first day of next period",
        "last": {
          "startDate": "2026-07-01",
          "endDate": "2026-07-14"
        },
        "defaultPeriod": "fortnightly",
        "today": "2026-07-15",
        "expected": [
          {
            "startDate": "2026-07-15",
            "endDate": "2026-07-28"
          }
        ]
      },
      {
        "name": "app unopened for three weekly periods",
        "last": {
          "startDate": "2026-06-01",
          "endDate": "2026-06-07"
        },
        "defaultPeriod": "weekly",
        "today": "2026-06-25",
        "expected": [
          {
            "startDate": "2026-06-08",
            "endDate": "2026-06-14"
          },
          {
            "startDate": "2026-06-15",
            "endDate": "2026-06-21"
          },
          {
            "startDate": "2026-06-22",
            "endDate": "2026-06-28"
          }
        ]
      },
      {
        "name": "weekly -> fortnightly switch applies to the NEXT period",
        "last": {
          "startDate": "2026-06-10",
          "endDate": "2026-06-16"
        },
        "defaultPeriod": "fortnightly",
        "today": "2026-06-17",
        "expected": [
          {
            "startDate": "2026-06-17",
            "endDate": "2026-06-30"
          }
        ]
      },
      {
        "name": "no periods yet -> seed from anchor and cascade to today",
        "last": null,
        "anchorDate": "2026-07-01",
        "defaultPeriod": "fortnightly",
        "today": "2026-07-20",
        "expected": [
          {
            "startDate": "2026-07-01",
            "endDate": "2026-07-14"
          },
          {
            "startDate": "2026-07-15",
            "endDate": "2026-07-28"
          }
        ]
      },
      {
        "name": "anchor in the future -> nothing yet",
        "last": null,
        "anchorDate": "2026-08-01",
        "defaultPeriod": "weekly",
        "today": "2026-07-20",
        "expected": []
      },
      {
        "name": "cascade across Sydney spring-forward (2026-10-04)",
        "last": {
          "startDate": "2026-09-28",
          "endDate": "2026-10-04"
        },
        "defaultPeriod": "weekly",
        "today": "2026-10-06",
        "expected": [
          {
            "startDate": "2026-10-05",
            "endDate": "2026-10-11"
          }
        ]
      },
      {
        "name": "today IS the last day of the last period -> still nothing",
        "last": {
          "startDate": "2026-07-01",
          "endDate": "2026-07-14"
        },
        "defaultPeriod": "fortnightly",
        "today": "2026-07-14",
        "expected": []
      },
      {
        "name": "today IS the last day of the period being created -> just that one",
        "last": {
          "startDate": "2026-07-01",
          "endDate": "2026-07-14"
        },
        "defaultPeriod": "fortnightly",
        "today": "2026-07-28",
        "expected": [
          {
            "startDate": "2026-07-15",
            "endDate": "2026-07-28"
          }
        ]
      },
      {
        "name": "the anchor IS today -> the first period starts now",
        "last": null,
        "anchorDate": "2026-07-01",
        "defaultPeriod": "fortnightly",
        "today": "2026-07-01",
        "expected": [
          {
            "startDate": "2026-07-01",
            "endDate": "2026-07-14"
          }
        ]
      }
    ]
  },
  "todayInTimezone": {
    "comment": "Local calendar date for a UTC instant. The 23:30-in-Sydney case is the failure mode this whole design avoids.",
    "cases": [
      {
        "instant": "2026-07-11T13:30:00Z",
        "timezone": "Australia/Sydney",
        "expected": "2026-07-11"
      },
      {
        "instant": "2026-07-11T14:30:00Z",
        "timezone": "Australia/Sydney",
        "expected": "2026-07-12"
      },
      {
        "instant": "2026-04-04T12:59:00Z",
        "timezone": "Australia/Sydney",
        "expected": "2026-04-04"
      },
      {
        "instant": "2026-04-04T14:30:00Z",
        "timezone": "Australia/Sydney",
        "expected": "2026-04-05"
      },
      {
        "instant": "2026-04-04T16:30:00Z",
        "timezone": "Australia/Sydney",
        "expected": "2026-04-05"
      },
      {
        "instant": "2026-10-03T13:59:00Z",
        "timezone": "Australia/Sydney",
        "expected": "2026-10-03"
      },
      {
        "instant": "2026-10-03T15:59:00Z",
        "timezone": "Australia/Sydney",
        "expected": "2026-10-04"
      },
      {
        "instant": "2026-10-03T17:00:00Z",
        "timezone": "Australia/Sydney",
        "expected": "2026-10-04"
      },
      {
        "instant": "2026-07-12T02:30:00Z",
        "timezone": "America/Argentina/Buenos_Aires",
        "expected": "2026-07-11"
      }
    ]
  },
  "budgetState": {
    "comment": "State of the budget progress bar. over: spent > budget. warning: spent/budget >= 0.85. comfortable otherwise. Matches the design's three states (Van bien / Queda poco / Se pasaron).",
    "warningThreshold": 0.85,
    "cases": [
      {
        "spentCents": 61240,
        "budgetCents": 90000,
        "expected": "comfortable"
      },
      {
        "spentCents": 80280,
        "budgetCents": 90000,
        "expected": "warning"
      },
      {
        "spentCents": 97310,
        "budgetCents": 90000,
        "expected": "over"
      },
      {
        "spentCents": 76500,
        "budgetCents": 90000,
        "expected": "warning"
      },
      {
        "spentCents": 76499,
        "budgetCents": 90000,
        "expected": "comfortable"
      },
      {
        "spentCents": 90000,
        "budgetCents": 90000,
        "expected": "warning"
      },
      {
        "spentCents": 90001,
        "budgetCents": 90000,
        "expected": "over"
      },
      {
        "spentCents": 0,
        "budgetCents": 90000,
        "expected": "comfortable"
      }
    ]
  },
  "extendToFortnight": {
    "comment": "Turning the week under way into two weeks, mid-period. The new end date is the SAME date a fortnightly period starting that day would have had (startDate + 13), so the next period still begins on the household's usual weekday — Cristian's weeks run Friday to Thursday, and an extended one ends the Thursday after next. Extending is one-way and only applies to a weekly period; a fortnight has nothing to extend into.",
    "cases": [
      {
        "name": "the real case: a Friday week becomes two, next one still starts a Friday",
        "startDate": "2026-08-07",
        "endDate": "2026-08-13",
        "period": "weekly",
        "expectedEndDate": "2026-08-20",
        "expectedAddedDays": 7
      },
      {
        "name": "crosses a month boundary",
        "startDate": "2026-08-28",
        "endDate": "2026-09-03",
        "period": "weekly",
        "expectedEndDate": "2026-09-10",
        "expectedAddedDays": 7
      },
      {
        "name": "crosses a year boundary",
        "startDate": "2026-12-25",
        "endDate": "2026-12-31",
        "period": "weekly",
        "expectedEndDate": "2027-01-07",
        "expectedAddedDays": 7
      },
      {
        "name": "spans the end of Sydney DST (calendar days, not wall-clock hours)",
        "startDate": "2026-04-01",
        "endDate": "2026-04-07",
        "period": "weekly",
        "expectedEndDate": "2026-04-14",
        "expectedAddedDays": 7
      },
      {
        "name": "spans the start of Sydney DST",
        "startDate": "2026-09-30",
        "endDate": "2026-10-06",
        "period": "weekly",
        "expectedEndDate": "2026-10-13",
        "expectedAddedDays": 7
      },
      {
        "name": "spans 29 February in a leap year",
        "startDate": "2028-02-24",
        "endDate": "2028-03-01",
        "period": "weekly",
        "expectedEndDate": "2028-03-08",
        "expectedAddedDays": 7
      },
      {
        "name": "a fortnight cannot be extended again",
        "startDate": "2026-08-07",
        "endDate": "2026-08-20",
        "period": "fortnightly",
        "expectedEndDate": null,
        "expectedAddedDays": null
      }
    ]
  },
  "stretchPeriodTo": {
    "comment": "Buying DAYS, not money: the end date moves out to a chosen date and the budget stays put, which is how the household moves the weekday its budget starts on without throwing away what is left in the week that just ended. Because periods chain from previous.endDate + 1, moving that one date is the whole mechanism. Forward only — days given up would belong to no period, so every expense logged in them would leave every total — and capped at 31 days from startDate, past which the date is a typo. A refusal is expectedEndDate: null.",
    "maxStretchedDays": 31,
    "cases": [
      {
        "name": "the real case: a week stretched through Sunday so the next one starts Monday",
        "startDate": "2026-08-28",
        "endDate": "2026-09-03",
        "toEndDate": "2026-09-06",
        "today": "2026-09-04",
        "expectedEndDate": "2026-09-06",
        "expectedAddedDays": 3
      },
      {
        "name": "one day is a stretch",
        "startDate": "2026-08-28",
        "endDate": "2026-09-03",
        "toEndDate": "2026-09-04",
        "today": "2026-09-04",
        "expectedEndDate": "2026-09-04",
        "expectedAddedDays": 1
      },
      {
        "name": "crosses a year boundary",
        "startDate": "2026-12-25",
        "endDate": "2026-12-31",
        "toEndDate": "2027-01-03",
        "today": "2027-01-01",
        "expectedEndDate": "2027-01-03",
        "expectedAddedDays": 3
      },
      {
        "name": "spans the start of Sydney DST — calendar days, not wall-clock hours",
        "startDate": "2026-09-28",
        "endDate": "2026-10-04",
        "toEndDate": "2026-10-07",
        "today": "2026-10-05",
        "expectedEndDate": "2026-10-07",
        "expectedAddedDays": 3
      },
      {
        "name": "spans the end of Sydney DST",
        "startDate": "2026-03-30",
        "endDate": "2026-04-05",
        "toEndDate": "2026-04-08",
        "today": "2026-04-06",
        "expectedEndDate": "2026-04-08",
        "expectedAddedDays": 3
      },
      {
        "name": "refuses to shrink: the days given up would hold orphaned expenses",
        "startDate": "2026-08-28",
        "endDate": "2026-09-03",
        "toEndDate": "2026-09-01",
        "today": "2026-09-04",
        "expectedEndDate": null,
        "expectedAddedDays": null
      },
      {
        "name": "refuses the same end date: nothing is being bought",
        "startDate": "2026-08-28",
        "endDate": "2026-09-03",
        "toEndDate": "2026-09-03",
        "today": "2026-09-01",
        "expectedEndDate": null,
        "expectedAddedDays": null
      },
      {
        "name": "refuses to end before today",
        "startDate": "2026-08-28",
        "endDate": "2026-09-03",
        "toEndDate": "2026-09-04",
        "today": "2026-09-10",
        "expectedEndDate": null,
        "expectedAddedDays": null
      },
      {
        "name": "31 days from the start is the last one allowed",
        "startDate": "2026-08-28",
        "endDate": "2026-09-03",
        "toEndDate": "2026-09-27",
        "today": "2026-09-04",
        "expectedEndDate": "2026-09-27",
        "expectedAddedDays": 24
      },
      {
        "name": "32 days is a typo, not a stretch",
        "startDate": "2026-08-28",
        "endDate": "2026-09-03",
        "toEndDate": "2026-09-28",
        "today": "2026-09-04",
        "expectedEndDate": null,
        "expectedAddedDays": null
      },
      {
        "name": "a mistyped year is refused by the same cap",
        "startDate": "2026-08-28",
        "endDate": "2026-09-03",
        "toEndDate": "2027-09-06",
        "today": "2026-09-04",
        "expectedEndDate": null,
        "expectedAddedDays": null
      }
    ]
  }
}
