rules_version = '2';

// ===============================================================
// Gastos Diarios — Firestore security rules
// These rules ARE the security boundary: there is no backend.
// Contract: shared/schema.md (any change there must be mirrored here).
// ===============================================================
//
// Assumed data model
//
// Collection: users
// Document ID: {uid} (Firebase Auth uid)
// Fields:
//   - displayName: string (required, 1..80)
//   - householdId: string|null (optional; denormalized convenience — when set,
//     the user must be a member of that household after this write)
//   - language: "es"|"en"|null (optional)
//   - displayCurrency: string|null (optional, ISO 4217 uppercase; DEPRECATED —
//     no client writes it any more, still accepted for older builds)
//   - defaultEntryCurrency: "AUD"|"USD"|null (optional; DEPRECATED — AUD is the
//     only entry currency now. No client reads or writes it, but existing user
//     docs still carry it, so it stays accepted: dropping it from hasOnly()
//     would make every later update of those docs fail)
//   - createdAt: timestamp (required, server time, immutable)
//   - updatedAt: timestamp (required, server time)
//
// Collection: households
// Document ID: random
// Fields:
//   - name: string (required, 1..60)
//   - currency: string (required, ISO 4217 uppercase)
//   - timezone: string (required, IANA, 1..60)
//   - defaultBudget: map { amountCents: int>0, period: "weekly"|"fortnightly",
//     anchorDate: "YYYY-MM-DD" } (required)
//   - memberIds: list<string> (required, size 1..2 — HARD CAP OF 2)
//   - memberProfiles: map<uid, {displayName: string 1..80, color: "#RRGGBB"}>
//     (required, keys ⊆ memberIds semantics enforced per-branch)
//   - categories: map<id, category> (required, ≤ 30 entries; entry shape is a
//     client contract — map entries cannot be iterated in rules)
//   - cards: map<last4, {kind: "debit"|"credit", brand?: "visa"|"mastercard"}>
//     (optional, ≤ 6 entries) — which of the household's cards each of the
//     bank's "finalizada en NNNN" charges came from, so a debit charge can be
//     routed to expense verification and a credit one to a card statement. Same
//     client-contract entry shape as categories, for the same reason
//   - createdAt: timestamp (required, server time, immutable)
//   - updatedAt: timestamp (required, server time)
//
// Subcollection: households/{id}/expenses
// Document ID: random
// Fields:
//   - amountCents: int (required, 1..10_000_000)
//   - categoryId: string (required, 1..40)
//   - note: string (required, may be empty, ≤ 200)
//   - date: "YYYY-MM-DD" string (required; household-timezone calendar date)
//   - createdBy: uid string (required, = author on create, immutable)
//   - createdAt: timestamp (required, server time, immutable)
//   - updatedAt: timestamp (required, server time)
//
// Subcollection: households/{id}/bankCharges
// Document ID: the Gmail message id of the bank's notification (so re-reading
//   the same email can never create a second charge)
// Fields (written ONLY by the Gmail ingestion service account, which is an IAM
//   principal and therefore bypasses these rules — clients may read the charges
//   and delete the ones they have dealt with, and nothing else):
//   - usdCents: int (required, 1..10_000_000) — what the bank charged
//   - date: "YYYY-MM-DD" (required) — the charge in the HOUSEHOLD timezone
//   - merchant: string (required, may be empty, ≤ 120)
//   - cardLast4: string (optional, 4 digits)
//   - importedAt: timestamp (required)
//
// Subcollection: households/{id}/periodBudgets
// Document ID: {startDate} ("YYYY-MM-DD") — idempotent materialization
// Fields:
//   - startDate: string (required, == doc ID, immutable)
//   - endDate: string (required, "YYYY-MM-DD", > startDate, immutable)
//   - period: "weekly"|"fortnightly" (required, immutable)
//   - amountCents: int (required, 1..100_000_000) — the EFFECTIVE budget for
//     the period, i.e. already including any carried-over leftover
//   - source: "default"|"custom" (required)
//   - rolloverCents: int (optional, signed) — how much of amountCents came
//     from the previous period's leftover; display only
//   - createdAt: timestamp (required, server time, immutable)
//   - updatedAt: timestamp (required, server time)
//   Deletes are DENIED: past periods are an immutable historical record.
//   startDate never moves. endDate and period move in exactly ONE case: the
//   week under way being stretched into a fortnight (weekly → fortnightly,
//   end date strictly later, amount only growing). See the update rule.
//
// Subcollection: households/{id}/services
// Document ID: random
// A recurring bill. Standalone: nothing sums these against the budget.
// Fields:
//   - name: string (required, 1..80)
//   - amountAudCents: int (optional, 1..10_000_000)
//   - amountUsdCents: int (optional, 1..10_000_000)
//     — at least ONE of the two is required; the USD figure is typed here (the
//       provider bills in it), it is not a conversion of the AUD one
//   - interval: "monthly"|"bimonthly"|"quarterly"|"biannual"|"yearly" (required)
//   - dueDay: int (required, 1..31) — day of the month it falls due
//   - anchorMonth: int (1..12) — which month the cycle lands on; REQUIRED unless
//     interval is "monthly", and forbidden when it is (every month is a due
//     month, so there is nothing left to anchor)
//   - paidWith: "debit"|"credit" (required)
//   - createdBy: uid string (required, = author on create, immutable)
//   - createdAt: timestamp (required, server time, immutable)
//   - updatedAt: timestamp (required, server time)
//
// Subcollection: households/{id}/cardStatements
// Document ID: {closingDate} ("YYYY-MM-DD") — idempotent, like periodBudgets.
// The OPEN statement is just the one with the greatest closingDate; there is no
// status field, so "close this one and open the next" is a single create and two
// clients cannot disagree about which is current.
// Fields:
//   - startDate: string (required, "YYYY-MM-DD", ≤ closingDate, immutable)
//   - closingDate: string (required, == doc ID, immutable by construction)
//   - dueDate: string (required, "YYYY-MM-DD", > closingDate)
//   - createdAt: timestamp (required, server time, immutable)
//   - updatedAt: timestamp (required, server time)
//   Deletes ARE allowed: a statement opened with the wrong dates has to be
//   undoable, and no charge points at it to be orphaned.
//
// Subcollection: households/{id}/cardCharges
// Document ID: random
// A purchase on a credit card, ALWAYS in USD (the card's billing currency).
// Belongs to the statement whose [startDate, closingDate] contains its date —
// it stores no statement id, exactly as an expense stores no period id.
// Fields:
//   - date: "YYYY-MM-DD" string (required; household-timezone calendar date)
//   - detail: string (required, may be empty, ≤ 200)
//   - card: "visa"|"mastercard" (required)
//   - usdCents: int (required, 1..10_000_000)
//   - createdBy: uid string (required, = author on create, immutable)
//   - createdAt: timestamp (required, server time, immutable)
//   - updatedAt: timestamp (required, server time)
//
// Collection: invites
// Document ID: {code} — the code IS the capability (≥ 10 chars, crypto-random,
//   `list` denied so codes cannot be enumerated)
// Fields:
//   - householdId: string (required; creator must be a member)
//   - createdBy: uid string (required, = author)
//   - createdAt: timestamp (required, server time)
//
// Join flow: joiner `get`s invites/{code} → self-add update on the household
// touching ONLY memberIds (+ own memberProfiles entry + updatedAt), adding
// ONLY themselves, ONLY while memberIds.size() < 2. Knowing the household ID
// is treated as capability-equivalent to knowing the invite code (household
// IDs are random and never listable).
// ===============================================================

service cloud.firestore {
  match /databases/{database}/documents {

    // ============================ Helpers ============================

    function isAuthenticated() {
      return request.auth != null;
    }

    function isOwner(uid) {
      return isAuthenticated() && request.auth.uid == uid;
    }

    // Membership check for subcollections (get() is cached per request)
    function isMember(householdId) {
      return isAuthenticated()
        && request.auth.uid in get(/databases/$(database)/documents/households/$(householdId)).data.memberIds;
    }

    // Format + logical range (month 01-12, day 01-31). Month-length /
    // leap-year correctness is a client responsibility; rules cannot
    // compute calendars.
    function isCalendarDate(value) {
      return value is string
        && value.matches('^[0-9]{4}-(0[1-9]|1[0-2])-(0[1-9]|[12][0-9]|3[01])$');
    }

    function isServerTimestamp(value) {
      return value is timestamp && value == request.time;
    }

    // ============================ users ============================

    function isValidUser(data) {
      return data.keys().hasOnly(['displayName', 'householdId', 'language', 'displayCurrency', 'defaultEntryCurrency', 'createdAt', 'updatedAt'])
        && data.keys().hasAll(['displayName', 'createdAt', 'updatedAt'])
        && data.displayName is string
        && data.displayName.size() >= 1 && data.displayName.size() <= 80
        && (!('householdId' in data) || data.householdId == null
            || (data.householdId is string && data.householdId.size() >= 1 && data.householdId.size() <= 60))
        && (!('language' in data) || data.language == null || data.language in ['es', 'en'])
        && (!('displayCurrency' in data) || data.displayCurrency == null
            || (data.displayCurrency is string && data.displayCurrency.matches('^[A-Z]{3}$')))
        && (!('defaultEntryCurrency' in data) || data.defaultEntryCurrency == null
            || data.defaultEntryCurrency in ['AUD', 'USD']);
    }

    // If householdId is set, the user must actually be a member of that
    // household once this write (or its batch) commits — getAfter() covers
    // the create-household-and-link batch.
    function householdLinkIsTruthful(data) {
      return !('householdId' in data) || data.householdId == null
        || request.auth.uid in getAfter(/databases/$(database)/documents/households/$(data.householdId)).data.memberIds;
    }

    match /users/{uid} {
      allow get: if isOwner(uid);
      allow list: if false;

      allow create: if isOwner(uid)
        && isValidUser(request.resource.data)
        && householdLinkIsTruthful(request.resource.data)
        && isServerTimestamp(request.resource.data.createdAt)
        && isServerTimestamp(request.resource.data.updatedAt);

      allow update: if isOwner(uid)
        && isValidUser(request.resource.data)
        && householdLinkIsTruthful(request.resource.data)
        && request.resource.data.createdAt == resource.data.createdAt
        && isServerTimestamp(request.resource.data.updatedAt);

      allow delete: if false;
    }

    // ============================ households ============================

    function isValidBudget(budget) {
      return budget is map
        && budget.keys().hasOnly(['amountCents', 'period', 'anchorDate', 'rollover'])
        && budget.keys().hasAll(['amountCents', 'period', 'anchorDate'])
        && budget.amountCents is int
        && budget.amountCents > 0 && budget.amountCents <= 100000000
        && budget.period in ['weekly', 'fortnightly']
        && isCalendarDate(budget.anchorDate)
        // Optional: carry the previous period's leftover into the next one.
        // Absent ⇒ off.
        && (!('rollover' in budget) || budget.rollover is bool);
    }

    function isValidMemberProfile(profile) {
      return profile is map
        && profile.keys().hasOnly(['displayName', 'color'])
        && profile.keys().hasAll(['displayName', 'color'])
        && profile.displayName is string
        && profile.displayName.size() >= 1 && profile.displayName.size() <= 80
        && profile.color is string
        && profile.color.matches('^#[0-9A-Fa-f]{6}$');
    }

    function isValidMemberIds(ids) {
      return ids is list
        && ids.size() >= 1 && ids.size() <= 2
        && ids[0] is string && ids[0].size() >= 1 && ids[0].size() <= 128
        && (ids.size() == 1
            || (ids[1] is string && ids[1].size() >= 1 && ids[1].size() <= 128 && ids[0] != ids[1]));
    }

    function isValidHousehold(data) {
      return data.keys().hasOnly(['name', 'currency', 'timezone', 'defaultBudget', 'memberIds', 'memberProfiles', 'categories', 'cards', 'createdAt', 'updatedAt'])
        && data.keys().hasAll(['name', 'currency', 'timezone', 'defaultBudget', 'memberIds', 'memberProfiles', 'categories', 'createdAt', 'updatedAt'])
        && data.name is string && data.name.size() >= 1 && data.name.size() <= 60
        && data.currency is string && data.currency.matches('^[A-Z]{3}$')
        && data.timezone is string && data.timezone.size() >= 1 && data.timezone.size() <= 60
        && isValidBudget(data.defaultBudget)
        && isValidMemberIds(data.memberIds)
        && data.memberProfiles is map && data.memberProfiles.size() <= 2
        && data.categories is map && data.categories.size() >= 1 && data.categories.size() <= 30
        // Optional so every household that predates it keeps validating — a
        // required field here would reject the next write on all of them.
        && (!('cards' in data) || (data.cards is map && data.cards.size() <= 6));
    }

    // Join self-add: a non-member adds ONLY themselves, touching ONLY
    // memberIds + their own memberProfiles entry + updatedAt, ONLY while
    // there is a free seat. Once the second member joins, the household is
    // locked forever.
    function isSelfAddJoin() {
      return isAuthenticated()
        && !(request.auth.uid in resource.data.memberIds)
        && resource.data.memberIds.size() < 2
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['memberIds', 'memberProfiles', 'updatedAt'])
        && request.resource.data.memberIds.size() == resource.data.memberIds.size() + 1
        && request.resource.data.memberIds.toSet()
             == resource.data.memberIds.toSet().union([request.auth.uid].toSet())
        && request.resource.data.memberProfiles.diff(resource.data.memberProfiles).affectedKeys().hasOnly([request.auth.uid])
        && isValidMemberProfile(request.resource.data.memberProfiles[request.auth.uid]);
    }

    match /households/{householdId} {
      allow get: if isAuthenticated() && request.auth.uid in resource.data.memberIds;
      allow list: if false;

      allow create: if isAuthenticated()
        && isValidHousehold(request.resource.data)
        && request.resource.data.memberIds == [request.auth.uid]
        && request.resource.data.memberProfiles.keys().hasOnly([request.auth.uid])
        && isValidMemberProfile(request.resource.data.memberProfiles[request.auth.uid])
        && isServerTimestamp(request.resource.data.createdAt)
        && isServerTimestamp(request.resource.data.updatedAt);

      allow update: if isValidHousehold(request.resource.data)
        && request.resource.data.createdAt == resource.data.createdAt
        && isServerTimestamp(request.resource.data.updatedAt)
        && (
          // (a) member edit: membership roster is immutable; a member may
          // edit only their OWN memberProfiles entry
          (request.auth != null
            && request.auth.uid in resource.data.memberIds
            && request.resource.data.memberIds == resource.data.memberIds
            && (request.resource.data.memberProfiles == resource.data.memberProfiles
                || (request.resource.data.memberProfiles.diff(resource.data.memberProfiles).affectedKeys().hasOnly([request.auth.uid])
                    && isValidMemberProfile(request.resource.data.memberProfiles[request.auth.uid])))
          )
          // (b) invite-code join: strict self-add
          || isSelfAddJoin()
        );

      allow delete: if false;

      // ------------------------ expenses ------------------------

      function isValidExpense(data) {
        return data.keys().hasOnly(['amountCents', 'categoryId', 'note', 'date', 'createdBy', 'createdAt', 'updatedAt', 'usdCents', 'verified'])
          && data.keys().hasAll(['amountCents', 'categoryId', 'note', 'date', 'createdBy', 'createdAt', 'updatedAt'])
          && data.amountCents is int
          && data.amountCents > 0 && data.amountCents <= 10000000
          && data.categoryId is string
          && data.categoryId.size() >= 1 && data.categoryId.size() <= 40
          && data.note is string && data.note.size() <= 200
          && isCalendarDate(data.date)
          // amountCents is the household currency (AUD) — the only currency
          // anyone types.
          && data.createdBy is string
          && isValidVerification(data);
      }

      // usdCents is what the BANK charged in USD (never a conversion, never
      // summed). It and `verified: true` are co-dependent: an expense may carry
      // both or neither, so nothing can claim to be verified without the figure
      // that verifies it. `verified: false` alone is fine — that is what the
      // clients write on create — and both absent reads as unverified, which is
      // how the docs that predate the fields keep working.
      function isValidVerification(data) {
        return ('usdCents' in data)
          ? (data.usdCents is int
              && data.usdCents > 0 && data.usdCents <= 10000000
              && ('verified' in data) && data.verified == true)
          : (!('verified' in data) || data.verified == false);
      }

      match /expenses/{expenseId} {
        allow read: if isMember(householdId);

        allow create: if isMember(householdId)
          && isValidExpense(request.resource.data)
          && request.resource.data.createdBy == request.auth.uid
          && isServerTimestamp(request.resource.data.createdAt)
          && isServerTimestamp(request.resource.data.updatedAt);

        // Either member can edit any expense (createdBy is attribution, not
        // ownership) — but attribution and createdAt are immutable.
        allow update: if isMember(householdId)
          && isValidExpense(request.resource.data)
          && request.resource.data.createdBy == resource.data.createdBy
          && request.resource.data.createdAt == resource.data.createdAt
          && isServerTimestamp(request.resource.data.updatedAt);

        allow delete: if isMember(householdId);
      }

      // ------------------------ bankCharges ------------------------

      // A charge the bank reported by email, waiting to be matched to an
      // expense. The ingestion writes these with a service account (an IAM
      // principal, so rules do not apply to it); from a client they are
      // READ-ONLY except for the delete that retires one, which is how a
      // matched or discarded charge leaves the list. No client create or
      // update: nobody should be able to invent a bank charge, and a charge
      // never changes once imported.
      match /bankCharges/{messageId} {
        allow read: if isMember(householdId);
        allow create, update: if false;
        allow delete: if isMember(householdId);
      }

      // ------------------------ periodBudgets ------------------------

      function isValidPeriodBudget(data, startDateId) {
        return data.keys().hasOnly(['startDate', 'endDate', 'period', 'amountCents', 'source', 'rolloverCents', 'createdAt', 'updatedAt'])
          && data.keys().hasAll(['startDate', 'endDate', 'period', 'amountCents', 'source', 'createdAt', 'updatedAt'])
          && isCalendarDate(data.startDate)
          && data.startDate == startDateId
          && isCalendarDate(data.endDate)
          && data.endDate > data.startDate
          && data.period in ['weekly', 'fortnightly']
          && data.amountCents is int
          && data.amountCents > 0 && data.amountCents <= 100000000
          && data.source in ['default', 'custom']
          // How much of amountCents was carried over from the previous period.
          // Informational: amountCents is ALREADY the effective budget. Signed,
          // because an overspent period carries its deficit forward.
          && (!('rolloverCents' in data)
              || (data.rolloverCents is int
                  && data.rolloverCents >= -100000000
                  && data.rolloverCents <= 100000000));
      }

      match /periodBudgets/{startDate} {
        allow read: if isMember(householdId);

        allow create: if isMember(householdId)
          && isValidPeriodBudget(request.resource.data, startDate)
          && isServerTimestamp(request.resource.data.createdAt)
          && isServerTimestamp(request.resource.data.updatedAt);

        // Two shapes of update, and nothing else.
        //
        // (a) Re-budgeting: the amount, and what of it was carried in — which
        //     is that amount's explanation. Boundaries do not move.
        // (b) Extending the week under way into a fortnight. This DOES move the
        //     end date, which every other rule here refuses, so it is fenced in
        //     hard: only forward, only weekly → fortnightly, only with the start
        //     date and the carried-in figure untouched, and the budget can only
        //     grow. One-way by construction — there is no branch back.
        //
        // What the rules cannot check is that the new end date is exactly
        // startDate + 13: rules have no date arithmetic. That sum is the
        // clients' job, and both compute it from the same
        // `extendToFortnight` vectors, exactly as every other period
        // calculation in this app is kept honest.
        allow update: if isMember(householdId)
          && isValidPeriodBudget(request.resource.data, startDate)
          && isServerTimestamp(request.resource.data.updatedAt)
          && (
            // (a) re-budget
            (request.resource.data.diff(resource.data).affectedKeys().hasOnly(['amountCents', 'source', 'rolloverCents', 'updatedAt'])
              && request.resource.data.endDate == resource.data.endDate
              && request.resource.data.period == resource.data.period)
            // (b) extend
            || (request.resource.data.diff(resource.data).affectedKeys().hasOnly(['amountCents', 'source', 'period', 'endDate', 'updatedAt'])
              && resource.data.period == 'weekly'
              && request.resource.data.period == 'fortnightly'
              && request.resource.data.startDate == resource.data.startDate
              && request.resource.data.endDate > resource.data.endDate
              && request.resource.data.amountCents >= resource.data.amountCents
              && request.resource.data.source == 'custom')
          );

        // Past periods are an immutable historical record.
        allow delete: if false;
      }

      // ------------------------ services ------------------------

      // At least one price, each a positive integer-cent amount. A service
      // carrying neither would be a row that says nothing; allowing only one
      // is deliberate, since plenty of bills are quoted in a single currency.
      function isValidServiceAmounts(data) {
        return (('amountAudCents' in data) || ('amountUsdCents' in data))
          && (!('amountAudCents' in data)
              || (data.amountAudCents is int
                  && data.amountAudCents > 0 && data.amountAudCents <= 10000000))
          && (!('amountUsdCents' in data)
              || (data.amountUsdCents is int
                  && data.amountUsdCents > 0 && data.amountUsdCents <= 10000000));
      }

      function isValidService(data) {
        return data.keys().hasOnly(['name', 'amountAudCents', 'amountUsdCents', 'interval', 'dueDay', 'anchorMonth', 'paidWith', 'createdBy', 'createdAt', 'updatedAt'])
          && data.keys().hasAll(['name', 'interval', 'dueDay', 'paidWith', 'createdBy', 'createdAt', 'updatedAt'])
          && data.name is string
          && data.name.size() >= 1 && data.name.size() <= 80
          && isValidServiceAmounts(data)
          && data.interval in ['monthly', 'bimonthly', 'quarterly', 'biannual', 'yearly']
          && data.dueDay is int && data.dueDay >= 1 && data.dueDay <= 31
          // Monthly needs no anchor and must not carry a stale one; every other
          // interval is meaningless without knowing which month it lands on.
          && (data.interval == 'monthly'
              ? !('anchorMonth' in data)
              : (data.anchorMonth is int
                 && data.anchorMonth >= 1 && data.anchorMonth <= 12))
          && data.paidWith in ['debit', 'credit']
          && data.createdBy is string;
      }

      match /services/{serviceId} {
        allow read: if isMember(householdId);

        allow create: if isMember(householdId)
          && isValidService(request.resource.data)
          && request.resource.data.createdBy == request.auth.uid
          && isServerTimestamp(request.resource.data.createdAt)
          && isServerTimestamp(request.resource.data.updatedAt);

        allow update: if isMember(householdId)
          && isValidService(request.resource.data)
          && request.resource.data.createdBy == resource.data.createdBy
          && request.resource.data.createdAt == resource.data.createdAt
          && isServerTimestamp(request.resource.data.updatedAt);

        allow delete: if isMember(householdId);
      }

      // ------------------------ cardStatements ------------------------

      function isValidStatement(data, closingDateId) {
        return data.keys().hasOnly(['startDate', 'closingDate', 'dueDate', 'createdAt', 'updatedAt'])
          && data.keys().hasAll(['startDate', 'closingDate', 'dueDate', 'createdAt', 'updatedAt'])
          && isCalendarDate(data.startDate)
          && isCalendarDate(data.closingDate)
          && data.closingDate == closingDateId
          && data.startDate <= data.closingDate
          && isCalendarDate(data.dueDate)
          // The bill is always payable after it closes.
          && data.dueDate > data.closingDate;
      }

      match /cardStatements/{closingDate} {
        allow read: if isMember(householdId);

        allow create: if isMember(householdId)
          && isValidStatement(request.resource.data, closingDate)
          && isServerTimestamp(request.resource.data.createdAt)
          && isServerTimestamp(request.resource.data.updatedAt);

        // Only the due date can be corrected after the fact. The window a
        // statement covers is what its charges are bucketed by, so moving it
        // would silently re-file charges nobody touched.
        allow update: if isMember(householdId)
          && isValidStatement(request.resource.data, closingDate)
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['dueDate', 'updatedAt'])
          && isServerTimestamp(request.resource.data.updatedAt);

        // Unlike a period, a statement opened with the wrong dates has to be
        // undoable — and no charge points at it, so nothing is orphaned.
        allow delete: if isMember(householdId);
      }

      // ------------------------ cardCharges ------------------------

      function isValidCardCharge(data) {
        return data.keys().hasOnly(['date', 'detail', 'card', 'usdCents', 'createdBy', 'createdAt', 'updatedAt'])
          && data.keys().hasAll(['date', 'detail', 'card', 'usdCents', 'createdBy', 'createdAt', 'updatedAt'])
          && isCalendarDate(data.date)
          && data.detail is string && data.detail.size() <= 200
          && data.card in ['visa', 'mastercard']
          // USD, always: this is the card's own billing currency, and unlike an
          // expense's usdCents it is what the user typed, not the bank's number.
          && data.usdCents is int
          && data.usdCents > 0 && data.usdCents <= 10000000
          && data.createdBy is string;
      }

      match /cardCharges/{chargeId} {
        allow read: if isMember(householdId);

        allow create: if isMember(householdId)
          && isValidCardCharge(request.resource.data)
          && request.resource.data.createdBy == request.auth.uid
          && isServerTimestamp(request.resource.data.createdAt)
          && isServerTimestamp(request.resource.data.updatedAt);

        allow update: if isMember(householdId)
          && isValidCardCharge(request.resource.data)
          && request.resource.data.createdBy == resource.data.createdBy
          && request.resource.data.createdAt == resource.data.createdAt
          && isServerTimestamp(request.resource.data.updatedAt);

        allow delete: if isMember(householdId);
      }
    }

    // ============================ invites ============================

    function isValidInvite(data, code) {
      return data.keys().hasOnly(['householdId', 'createdBy', 'createdAt'])
        && data.keys().hasAll(['householdId', 'createdBy', 'createdAt'])
        && data.householdId is string
        && data.householdId.size() >= 1 && data.householdId.size() <= 60
        && data.createdBy == request.auth.uid
        && code.size() >= 10 && code.size() <= 40;
    }

    match /invites/{code} {
      // Knowing the code is the capability; enumeration is impossible
      // because list is denied.
      allow get: if isAuthenticated();
      allow list: if false;

      allow create: if isAuthenticated()
        && isValidInvite(request.resource.data, code)
        && isMember(request.resource.data.householdId)
        && isServerTimestamp(request.resource.data.createdAt);

      allow update: if false;

      // Members can revoke / clean up after joining.
      allow delete: if isMember(resource.data.householdId);
    }

    // Everything else: default deny.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
